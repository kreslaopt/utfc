    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки подголовника, спинки и сиденья: ткань<br>\n- цвет материала - по каталогу"
            ],
            "components": [
                "подголовника, спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Подголовник</strong> состоит из пластикового каркаса и обивочного элемента. Регулируется по высоте",
                "<strong>Спинка</strong> состоит из пластикового каркаса и обивочного элемента",
                "<strong>Сиденье</strong> состоит из пластикового каркаса и обивочного элемента",
                "<strong>Облицовка спинки и сиденья</strong>: ткань",
                "<strong>Подлокотники</strong> - алюминиевые, регулируются по высоте",
                "<strong>Механизм качания</strong> позволяет регулировать высоту сиденья, регулировку силы отклонения спинки под вес пользователя в режиме качания и фиксацию в вертикальном положении, слайд-система",
                "<strong>Газ-лифт</strong> с высотой подъема 80 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> алюминиевое d=680 мм с узкими лучами с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> d=60 мм имеют открытый пластиковый чехол"
            ]
        }
    ],
