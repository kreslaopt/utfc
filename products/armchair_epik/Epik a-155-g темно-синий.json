    "technical_requirements": [
        [
            "Кресло должно соответствовать требованиям:",
            "ГОСТ 19917-2014 «Мебель для сидения и лежания. Общие технические условия»",
            "ГОСТ 26800.3-86 «Мебель для административных помещений. Функциональные размеры»",
            "настоящего технического описания",
            "комплекта конструкторской документации",
            "образцу-эталону, утвержденному в установленном порядке производителем"
        ]
    ],
    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки спинки и сиденья кресла: экокожа<br>\n- цвет материала - по каталогу"
            ],
            "components": [
                "спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Спинка</strong> состоит из основания, вкладыша пенополиуретанового и обивочного материала",
                "<strong>Сиденье</strong> состоит из основания, вкладыша пенополиуретанового и обивочного элемента",
                "<strong>Облицовка спинки и сиденья</strong>: экокожа",
                "<strong>Подлокотники</strong> - алюминиевые с мягкими полиуретановыми накладками",
                "<strong>Механизм качания</strong> синхронный, позволяет регулировать высоту сиденья, жесткость отклонения спинки и обеспечивает фиксацию наклона в 4-х положениях",
                "<strong>Газ-лифт</strong> с высотой подъема 80 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> алюминиевое d=700 мм с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> с полиуретановым покрытием d=60 мм имеют узкий шток"
            ]
        }
    ],
