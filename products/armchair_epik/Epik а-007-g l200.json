    "technical_requirements": [
        [
            "Кресло должно соответствовать требованиям:",
            "ГОСТ 19917-2014 «Мебель для сидения и лежания. Общие технические условия»",
            "ГОСТ 26800.3-86 «Мебель для административных помещений. Функциональные размеры»",
            "настоящего технического описания",
            "комплекта конструкторской документации",
            "образцу-эталону, утвержденному в установленном порядке производителем"
        ]
    ],
    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки кресла:<br>\nнатуральная кожа (L)<br>\n- цвет материала - по каталогу"
            ],
            "components": [
                "подголовника, спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Подголовник</strong> состоит из увеличенной мягкой подушки и крышки из ABS-пластика, регулируется по высоте и фиксируется в 3-х положениях",
                "<strong>Спинка</strong> состоит из основания, вкладыша пенополиуретанового и обивочного материала",
                "<strong>Сиденье</strong> состоит из основания, вкладыша пенополиуретанового и обивочного элемента",
                "<strong>Подлокотники</strong> - алюминиевые с мягкими накладками, регулируются и фиксируются в нескольких положениях, имеют чехол из ABS – пластика",
                "<strong>Облицовка</strong> подголовника, спинки, сиденья и накладок подлокотников: натуральная кожа (L)",
                "<strong>Механизм качания</strong> синхронный со слайд-системой, позволяет регулировать высоту сиденья относительно пола",
                "<strong>Газ-лифт</strong> с высотой подъема 60 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> алюминиевое d=760 мм с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> d=60 мм имеют открытый пластиковый чехол"
            ]
        }
    ],
