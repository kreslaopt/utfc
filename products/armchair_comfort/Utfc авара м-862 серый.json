    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки спинки и подголовника: сетка<br>\n- материал облицовки сиденья: ткань"
            ],
            "components": [
                "подголовника, спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Спинка</strong> состоит из пластикового каркаса и обивочного элемента. Регулируемая поясничная поддержка - по высоте и глубине. <strong>Облицовка спинки:</strong> сетка",
                "<strong>Сиденье</strong> состоит из основания, пенополиуретана и обивочного элемента. <strong>Облицовка сиденья:</strong> ткань",
                "<strong>Подголовник</strong> состоит из пластикового каркаса и обивочного элемента. Регулируется по высоте и углу наклона. <strong>Облицовка подголовника:</strong> сетка",
                "<strong>Подлокотники</strong> пластиковые, крепятся к основанию сиденья и каркасу спинки с помощью винтов",
                "<strong>Механизм качания</strong> «Топ-ган» позволяет регулировать высоту сиденья, регулировку силы отклонения спинки под вес пользователя в режиме качания и фиксацию в вертикальном положении",
                "<strong>Газ-лифт</strong> черный с высотой подъема 80 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> d=660 мм пластиковое с узкими лучами с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> d=50 мм с полиуретановым покрытием имеют узкий шток"
            ]
        }
    ],
