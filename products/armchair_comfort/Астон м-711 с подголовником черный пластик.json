    "technical_requirements": [
        [
            "Кресло должно соответствовать требованиям:",
            "ГОСТ 19917-2014 «Мебель для сидения и лежания. Общие технические условия»",
            "ГОСТ 26800.3-86 «Мебель для административных помещений. Функциональные размеры»",
            "настоящего технического описания",
            "комплекта конструкторской документации",
            "образцу-эталону, утвержденному в установленном порядке производителем"
        ]
    ],
    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- исполнение: черный пластик или белый пластик"
            ],
            "components": [
                "подголовника, спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Подголовник</strong> состоит из черного пластикового каркаса, кронштейна и обивочного элемента. Регулируется по высоте и углу наклона. Крепится к каркасу спинки с помощью 2-х винтов. Облицовка подголовника: сетка LF черного или голубого цвета",
                "<strong>Спинка</strong> состоит из черного пластикового каркаса, кронштейна, поясничной поддержки и обивочного элемента. Кронштейн спинки металлический, соединяет спинку с механизмом качания. Поясничная поддержка из пластика регулируется по высоте на 3 см. Облицовка спинки: сетка LF черного или голубого цвета",
                "<strong>Сиденье</strong> состоит из основания фанерного, вкладыша пенополиуретанового (жесткость - 40, плотность — 20 кг/м<sup>3</sup>), чехла пластикового и обивочного элемента. <strong>Материал</strong> облицовки сиденья: ткань LF черного цвета",
                "<strong>Подлокотники</strong> пластиковые, белые, нерегулируемые. Крепятся к основанию сиденья и спинки с помощью винтов",
                "<strong>Механизм качания</strong> «Топ-ган с синхроплатой» позволяет регулировать высоту сиденья, регулировку силы отклонения спинки под вес пользователя в режиме качания и фиксацию в вертикальном положении. Под воздействием веса пользователя угол наклона спинки изменяется синхронно с углом наклона сиденья в оптимальной пропорции",
                "<strong>Газ-лифт</strong> хромированный с высотой подъема 70 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола",
                "<strong>Пятилучье</strong> пластиковое черное d=640 мм с узкими лучами с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> d=50 мм имеют узкий шток"
            ]
        }
    ],
