    "technical_requirements": [
        [
            "Кресло должно соответствовать требованиям:",
            "ГОСТ 19917-2014 «Мебель для сидения и лежания. Общие технические условия»",
            "ГОСТ 26800.3-86 «Мебель для административных помещений. Функциональные размеры»",
            "настоящего технического описания",
            "комплекта конструкторской документации",
            "образцу-эталону, утвержденному в установленном порядке производителем"
        ]
    ],
    "construction_and_materials": [
        {
            "upholstery_materials": [
                "- материал облицовки спинки:<br>сетка (D)<br>\n- материал облицовки сиденья:<br>ткань-сетка (E)<br>\n- цвет материала и пластика - по каталогу"
            ],
            "components": [
                "спинки, сиденья, подлокотников, механизма качания, газ-лифта, пятилучья и 5-ти роликов",
                "<strong>Спинка</strong> состоит из пластикового каркаса и обивочного элемента",
                "<strong>Материал</strong> облицовки спинки: сетка (D)",
                "<strong>Сиденье</strong> состоит из основания фанерного, вкладыша пенополиуретанового (жесткость - 40, плотность 22 кг/м<sup>3</sup>) и обивочного элемента",
                "<strong>Материал</strong> облицовка сиденья: ткань-сетка (Е)",
                "<strong>Подлокотники</strong> - пластиковые, крепятся к каркасу спинки и к основаниюсиденья с помощью винтов",
                "<strong>Механизм качания</strong> «Топ-ган» обеспечивает регулировку высоты сиденья, регулировку силы отклонения спинки под вес пользователя в режиме качания и фиксацию в вертикальном положении",
                "<strong>Газ-лифт</strong> с высотой подъема 100 мм ± 10 мм позволяет плавно регулировать высоту сиденья относительно пола. Газ-лифт закрыт телескопическим чехлом",
                "<strong>Пятилучье</strong> пластиковое d=700 мм с 5-тью роликами обеспечивает устойчивость и позволяет креслу легко поворачиваться и перемещаться по любому стандартному покрытию пола",
                "<strong>Ролики</strong> с полиуретановым покрытием d=50 мм имеют открытый пластиковый чехол"
            ]
        }
    ],
